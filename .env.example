# ============================================================
# Chitra Saree Centre — configuration
# Copy this file to ".env.local" and fill in the values.
# NEVER share .env.local or upload it to GitHub.
# ============================================================

# --- Website address (used for links in WhatsApp/Instagram/SEO) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (REQUIRED) — Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret! Server only. Never put this in any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Razorpay online payments (OPTIONAL — leave empty to hide online payment) ---
# Use rzp_test_... keys first (test mode, no real money). Switch to rzp_live_... when ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (OPTIONAL — without it, messages are logged in demo mode) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Names of your approved message templates in Meta Business Manager
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=order_confirmation
WHATSAPP_TEMPLATE_ORDER_STATUS=order_status_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Instagram Graph API (OPTIONAL — without it, you can still prepare and copy posts) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
